{
  "name": "kadia-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc -b --noEmit && esbuild src/check.ts --bundle --platform=node --format=esm --outfile=node_modules/.kadia-check.mjs --log-level=error && node node_modules/.kadia-check.mjs",
    "build": "npm run check && vite build",
    "demo": "npm run check && node build-demo.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
